{
  "name": "lx-urlaubsplanung",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "icons": "node scripts/make-icons.mjs",
    "desktop:prepare": "next build && node scripts/prepare-desktop.mjs",
    "desktop:start": "electron .",
    "desktop:dist": "npm run desktop:prepare && electron-builder --win"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "6.19.3",
    "@prisma/client": "^6.19.3",
    "better-sqlite3": "^13.0.3",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.42.0",
    "next": "16.3.4",
    "prisma": "^6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "overrides": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "better-sqlite3@12.11.1": true,
    "better-sqlite3@13.0.3": false,
    "electron@44.8.0": true
  },
  "main": "electron/main.cjs",
  "description": "Urlaubs- und Ferienplaner für Familien und kleine Teams",
  "author": "lx-labs.dev",
  "build": {
    "appId": "dev.lx-labs.urlaubsplanung",
    "productName": "lx-urlaubsplanung",
    "directories": { "output": "dist" },
    "files": ["electron/main.cjs", "electron/icon.png", "package.json", "!node_modules{,/**/*}"],
    "extraResources": [
      { "from": "build/standalone", "to": "standalone", "filter": ["**/*"] },
      { "from": "build/migrations", "to": "migrations" }
    ],
    "npmRebuild": false,
    "afterPack": "scripts/after-pack.cjs",
    "win": {
      "icon": "electron/icon.ico",
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "${productName}-${version}-setup.${ext}",
      "shortcutName": "lx-urlaubsplanung"
    },
    "portable": { "artifactName": "${productName}-${version}-portable.exe" }
  }
}
