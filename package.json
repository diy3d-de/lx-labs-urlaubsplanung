{
  "name": "lx-urlaubsplanung",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test \"tests/*.test.mjs\"",
    "typecheck": "next typegen && tsc --noEmit",
    "icons": "node scripts/make-icons.mjs",
    "desktop:deps": "npm ci --prefix electron --ignore-scripts",
    "desktop:prepare": "next build && node scripts/prepare-desktop.mjs",
    "desktop:start": "electron electron",
    "desktop:dist": "npm run desktop:prepare && electron-builder --win --publish never && node scripts/pruefe-paket.cjs"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "6.19.3",
    "@prisma/client": "^6.19.3",
    "better-sqlite3": "^13.0.3",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.42.0",
    "next": "16.3.4",
    "prisma": "^6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "overrides": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^44.8.0",
    "electron-builder": "26.16.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "better-sqlite3@12.11.1": true,
    "better-sqlite3@13.0.3": false,
    "electron@44.8.0": true
  },
  "build": {
    "appId": "dev.lx-labs.urlaubsplanung",
    "productName": "lx-urlaubsplanung",
    "directories": {
      "app": "electron",
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "updater.cjs",
      "updateKonfig.cjs",
      "updateFehlerKern.cjs",
      "releaseNotesKern.cjs",
      "icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/standalone",
        "to": "standalone",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/migrations",
        "to": "migrations"
      }
    ],
    "npmRebuild": false,
    "afterPack": "scripts/after-pack.cjs",
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "win": {
      "icon": "electron/icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "lx-urlaubsplanung",
      "artifactName": "lx-urlaubsplanung-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "diy3d-de",
      "repo": "lx-labs-urlaubsplanung",
      "releaseType": "draft"
    }
  }
}
